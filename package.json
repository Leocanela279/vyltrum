{
  "name": "vyltrum",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --port 3847",
    "build": "next build",
    "start": "next start --port 3847",
    "lint": "eslint",
    "remotion:studio": "remotion studio src/remotion/index.ts",
    "remotion:render": "remotion render src/remotion/index.ts VyltrumAd out/vyltrum-ad.mp4",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-build": "opennextjs-cloudflare build",
    "cf-deploy": "wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@remotion/google-fonts": "^4.0.545",
    "@remotion/player": "^4.0.545",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "geist": "^1.9.2",
    "lucide-react": "^1.75.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "^4.0.545",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@remotion/bundler": "^4.0.545",
    "@remotion/cli": "^4.0.545",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/culori": "^4.0.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "wrangler": "^4.164.0"
  }
}

{
  // Cloudflare Workers — OpenNext entry
  // Deploy: npm run deploy
  // Custom domain: Dashboard → Workers → vyltrum → Custom Domains → vyltrum.eu
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vyltrum",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "vyltrum.eu", "custom_domain": true },
    { "pattern": "www.vyltrum.eu", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "vyltrum"
    }
  ],
  "observability": {
    "enabled": true
  }
}
